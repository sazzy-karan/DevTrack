# Copy these values into your shell environment before running the app.
DEVTRACK_DB_URL=jdbc:mysql://localhost:3306/devtrack?serverTimezone=UTC
DEVTRACK_DB_USER=root
DEVTRACK_DB_PASSWORD=change-me

# Password recovery mail (Gmail requires an app password, not your sign-in password).
DEVTRACK_SMTP_HOST=smtp.gmail.com
DEVTRACK_SMTP_PORT=587
DEVTRACK_SMTP_USER=your-sending-account@gmail.com
DEVTRACK_SMTP_PASSWORD=your-gmail-app-password
DEVTRACK_SMTP_FROM=your-sending-account@gmail.com
